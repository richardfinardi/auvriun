{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auvriun-whatsapp",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "AUVRIUN_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WAPI_OUTBOX",
        "class_name": "WapiOutbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "wapi_outbox_v1",
      "new_sqlite_classes": [
        "WapiOutbox"
      ]
    }
  ]
}
